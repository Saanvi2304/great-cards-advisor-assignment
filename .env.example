# Copy this file to .env and fill in your values (never commit .env).

# Great.cards MCP server URL - the chatbot calls its tools at runtime.
MCP_URL="PASTE YOUR MCP URL HERE"

# LLM used to interpret questions and write answers (only "gemini" is supported).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY="PASTE YOUR GEMINI API KEY HERE"

# Optional: seconds to wait for the LLM before giving up (default 30)
LLM_TIMEOUT_SECONDS=30

# Optional: input/output guardrails (injection, fraud, tax, off-topic, approval promises).
# Default true. Can be switched at runtime from /admin; resets to this value on restart.
GUARDRAILS_ENABLED=true

# Optional: the /admin console is only reachable from this machine. Set a long random
# token to also allow it from other machines (you'll be asked for it on the admin page).
ADMIN_TOKEN=
