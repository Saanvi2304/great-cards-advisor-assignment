# Copy this file to .env and fill in your values (never commit .env).

# Great.cards MCP server URL - the chatbot calls its tools at runtime.
MCP_URL="PASTE YOUR MCP URL HERE"

# LLM used to interpret questions and write answers (only "gemini" is supported).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY="PASTE YOUR GEMINI API KEY HERE"

# Optional: seconds to wait for the LLM before giving up (default 30)
LLM_TIMEOUT_SECONDS=30
